<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Étape 1 : wipe core — Device Admin -->
    <uses-feature android:name="android.software.device_admin" android:required="false" />

    <!-- Étape 2 (Garde-clefs) : AccessibilityService pour scruter le lockscreen -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Biométrie optionnelle (Étape 7) : -->
    <!-- <uses-permission android:name="android.permission.USE_BIOMETRIC" /> -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wipe programmé : alarmes exactes requises pour des échéances longues -->
    <!-- SCHEDULE_EXACT_ALARM : Android 12 (API 31) jusqu'à 13 (API 33) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- USE_EXACT_ALARM : Android 13+ (API 33) pour apps calendrier/alarme/réveil -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".OblivionApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Oblivion2"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Oblivion2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Étape 1 : Device Admin receiver.
          ⚠️ Configuration identique à l'app originale qui fonctionne :
            - permission BIND_DEVICE_ADMIN
            - meta-data pointant vers res/xml/device_admin.xml (<wipe-data />)
            - intent-filter DEVICE_ADMIN_ENABLED
        -->
        <receiver
            android:name=".core.admin.DeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          Étape 2 : AccessibilityService du Garde-clefs.
            - permission BIND_ACCESSIBILITY_SERVICE requise par Android
            - directBootAware : le service se réactive avant que
              l'utilisateur ait déverrouillé après un reboot
            - meta-data pointant vers xml/guard_accessibility_service.xml
        -->
        <service
            android:name=".core.guard.GuardAccessibilityService"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_accessibility_service" />
        </service>

        <!--
          Étape 3 : redémarrage automatique du service après reboot.
          LOCKED_BOOT_COMPLETED permet de réagir même avant le premier
          déverrouillage utilisateur ; nécessite directBootAware si on
          veut vraiment accéder aux prefs avant unlock (pas indispensable
          pour cette étape — on redémarre aussi sur BOOT_COMPLETED).
        -->
        <!--
          Wipe programmé : receiver déclenché par AlarmManager à l'heure
          fixée par l'utilisateur.
            - exported="false" : déclenchement interne uniquement
        -->
        <receiver
            android:name=".core.scheduled.ScheduledWipeReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />

        <!--
          Scheduled wipe: re-arms the alarm after a reboot (AlarmManager
          loses its alarms on restart). directBootAware: must be able to
          fire even if the device has never been unlocked since the last
          reboot (the "confiscated, never unlocked" case).
        -->
        <receiver
            android:name=".core.scheduled.ScheduledWipeBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Dead Man's Switch: safety net for the "reboot then never
          unlocked again" case. The periodic WorkManager job
          (DeadmanWorker) handles the normal case (device unlocked/in
          use); it doesn't run during Direct Boot (a limitation of
          WorkManager itself). These two receivers cover exactly that
          gap, following the same pattern as Scheduled Wipe above.
        -->
        <receiver
            android:name=".core.deadman.DeadmanAlarmReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />

        <receiver
            android:name=".core.deadman.DeadmanBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
