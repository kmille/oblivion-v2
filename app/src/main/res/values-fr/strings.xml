    <!-- Wipe programmé                                                     -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <string name="scheduled_title">Wipe programmé</string>

    <string name="scheduled_admin_required">Admin appareil requis</string>
    <string name="scheduled_admin_required_desc">Active l\'admin appareil depuis l\'écran Test du wipe avant d\'armer le wipe programmé.</string>

    <string name="scheduled_exact_alarm_title">Permission d\'alarme exacte</string>
    <string name="scheduled_exact_alarm_desc">Android 12+ restreint les alarmes exactes. Accorde la permission pour que le wipe programmé se déclenche à l\'heure choisie.</string>
    <string name="scheduled_exact_alarm_grant">Accorder dans les paramètres</string>

    <string name="scheduled_arm_title">Armer le wipe</string>
    <string name="scheduled_arm_desc">Choisis une date et une heure dans le futur. Une fois atteint, l\'appareil est effacé silencieusement — aucune pré-alerte.</string>
    <string name="scheduled_arm_selected">Sélection : %1$s</string>
    <string name="scheduled_pick_date">Date</string>
    <string name="scheduled_pick_time">Heure</string>
    <string name="scheduled_arm_button">Armer le wipe</string>

    <string name="scheduled_armed_title">Wipe armé</string>
    <string name="scheduled_armed_at">Programmé pour %1$s</string>
    <string name="scheduled_armed_remaining">Temps restant : %1$s</string>
    <string name="scheduled_armed_expired">Expiré — effacement imminent.</string>
    <string name="scheduled_disarm_hint">Le désarmement exige une authentification biométrique.</string>
    <string name="scheduled_disarm_button">Désarmer (biométrie)</string>
    <string name="scheduled_disarm_prompt_title">Désarmer le wipe programmé</string>
    <string name="scheduled_disarm_prompt_subtitle">Authentifie-toi pour annuler le wipe programmé.</string>

    <string name="scheduled_rules_title">Règles</string>
    <string name="scheduled_rules_body">• AlarmManager se déclenche à l\'heure exacte, même en mode Doze.\n• Ré-armé automatiquement après un reboot.\n• 100%% silencieux : aucune notification, aucune pré-alerte.\n• L\'annulation exige une authentification biométrique.\n• Si l\'admin appareil est révoqué entre l\'armement et le déclenchement, le wipe est annulé.</string>

